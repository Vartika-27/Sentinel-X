# Sentinel-X – Backend Environment Variables
# Copy to .env and fill in your values before starting the server.

# Redis connection URL
# Format: redis://[user:password@]host:port[/db]
REDIS_URL=redis://localhost:6379

# PostgreSQL connection DSN
# Format: postgresql://user:password@host:port/database
POSTGRES_DSN=postgresql://postgres:password@localhost:5432/sentinelx
